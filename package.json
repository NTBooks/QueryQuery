{
  "name": "queryquery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, heuristic triage for literary query letters (.eml) — a slush-pile ticketing system that needs no AI (LM Studio optional).",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "queryquery": "server/index.js"
  },
  "scripts": {
    "start": "vite build && cross-env NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "serve": "cross-env NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "dev": "concurrently -n server,client -c blue,green \"cross-env NODE_ENV=development PORT=4711 nodemon server/index.js\" \"vite\"",
    "scrape": "node scripts/scrape-johnfox.js",
    "gen-samples": "node scripts/generate-samples.js",
    "gen-llm-samples": "node scripts/generate-llm-samples.js",
    "seed-input": "node scripts/seed-input.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "@chakra-ui/react": "^2.10.4",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@hello-pangea/dnd": "^16.6.0",
    "chakra-react-select": "^4.9.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "email-reply-parser": "^1.8.0",
    "express": "^4.21.2",
    "framer-motion": "^11.13.1",
    "get-port": "^7.1.0",
    "ipfs-only-hash": "^4.0.0",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "vite": "^5.4.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}

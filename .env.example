# QueryQuery environment configuration. Copy to ".env" and adjust.

# Where QueryQuery stores ALL persistent data: the SQLite database
# (queryquery.db), the config file, and the input/ folder for .eml files.
# Relative paths are resolved against the project root; an absolute path also works.
PERSIST_DIR=./persist

# --- First-run admin (only used when the database has no users yet) ---
# Set these BEFORE the very first start to choose the initial admin login.
# If ADMIN_PASSWORD is left unset, a random password is generated and printed
# once to the server log on first run. There is no hard-coded default credential.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Allow visitors to self-register accounts. Open in development; CLOSED by default
# in production (NODE_ENV=production). Set to 1 to enable public sign-up.
# QQ_ALLOW_REGISTRATION=0

# Reverse-proxy hops to trust for the real client IP (used by rate limiting).
# Defaults to 1 in production (one proxy, e.g. Coolify), 0 in development.
# TRUST_PROXY=1

# LLM proxy limits. Timeout per request in ms (default 180000 = 3 min; raise for a
# slow local reasoning model). Max concurrent LLM requests across all users.
# LLM_TIMEOUT_MS=180000
# LLM_MAX_CONCURRENT=3

# Escape hatch: allow the server to start in production even if the admin account
# still uses the default password "admin". Leave UNSET — it exists only for
# emergency recovery and disables a safety check.
# QQ_ALLOW_DEFAULT_ADMIN=1
